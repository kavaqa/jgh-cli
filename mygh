#!/usr/bin/env sh
# Wrapper that finds the fat-jar next to this script (skill layout) or in ./target
# (development layout), then runs it. Requires Java 17+ on PATH.
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$DIR/mygh.jar" ]; then
  JAR="$DIR/mygh.jar"
elif [ -f "$DIR/target/mygh.jar" ]; then
  JAR="$DIR/target/mygh.jar"
else
  echo "mygh: mygh.jar not found next to the wrapper or in target/ — build it with: mvn -q clean package" >&2
  exit 1
fi
exec java -jar "$JAR" "$@"
