#!/usr/bin/env sh
# Wrapper that runs the fat-jar built by `mvn clean package`.
# Usage: ./mygh pr threads 123
DIR="$(cd "$(dirname "$0")" && pwd)"
JAR="$DIR/target/mygh.jar"
if [ ! -f "$JAR" ]; then
  echo "mygh: $JAR not found — build it first with: mvn -q clean package" >&2
  exit 1
fi
exec java -jar "$JAR" "$@"
